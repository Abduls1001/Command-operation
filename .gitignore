# ─── Environment ──────────────────────────────────────────────────────────────
# Real secrets never enter version control. .env.example is the tracked template.
.env
.env.*
!.env.example

# ─── Python / backend ─────────────────────────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ─── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Next.js ──────────────────────────────────────────────────────────────────
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.vercel

# ─── Testing ──────────────────────────────────────────────────────────────────
/coverage

# ─── Editors & OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ─── Certificates ─────────────────────────────────────────────────────────────
*.pem
