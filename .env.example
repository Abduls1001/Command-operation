# AI Operations Command Center — environment template
#
# Copy this file to .env and fill in real values locally.
#
#     cp .env.example .env
#
# .env is git-ignored and must never be committed. This file contains no real
# credentials and never should.
#
# Variables are grouped by the phase that introduces them. Anything marked
# "not used yet" is listed so the shape of the configuration is visible early —
# leave those commented out until the phase that needs them arrives.


# ─── Backend (Phase 1) ────────────────────────────────────────────────────────

# Identifier returned by GET /health.
SERVICE_NAME=ai-operations-command-center-backend

# development | production
ENVIRONMENT=development

# Prefix for the domain API. Health lives at the root, outside this prefix.
API_PREFIX=/api

# Browser origins allowed to call the backend. Comma-separated.
CORS_ORIGINS=http://localhost:3000


# ─── Frontend (Phase 1) ───────────────────────────────────────────────────────

# Base URL of the backend API, as seen from the browser.
# NEXT_PUBLIC_ variables are embedded in the client bundle and are therefore
# PUBLIC. Never put a secret behind this prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# ─── Database (Phase 10 — not used yet) ───────────────────────────────────────

# POSTGRES_USER=aocc
# POSTGRES_PASSWORD=change-me-locally
# POSTGRES_DB=aocc
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://aocc:change-me-locally@localhost:5432/aocc


# ─── LLM provider (Phase 11 — not used yet) ───────────────────────────────────
#
# This key is server-side only. It must never be exposed to the frontend and
# must never carry a NEXT_PUBLIC_ prefix.

# LLM_API_KEY=
# LLM_MODEL=
